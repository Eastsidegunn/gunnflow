{
  "name": "@gunnflow-testing/fake-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulator backend for the Gunnflow contract: fake upstream streams, relays and fixtures (and stand-ins for upstream shapes not yet in the contract). Test/dev only.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./direct-server": "./src/directServer.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'fake-contracts: source-only package, no build'",
    "serve:direct": "tsx src/serveDirect.ts"
  },
  "dependencies": {
    "@gunnflow/contract": "workspace:*",
    "@gunnflow/upstream-port": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
