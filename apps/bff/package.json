{
  "name": "@gunnflow/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gunnflow BFF — transports projections and relays human intent through a single upstream port. It creates no new facts.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-viewers.mjs && tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build-viewers.mjs && tsc -p tsconfig.build.json",
    "build:viewers": "node scripts/build-viewers.mjs"
  },
  "dependencies": {
    "@gunnflow/contract": "workspace:*",
    "@gunnflow/upstream-port": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@gunnflow-testing/fake-contracts": "workspace:*",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
